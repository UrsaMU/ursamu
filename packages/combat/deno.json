{
  "name": "@ursamu/combat",
  "version": "0.3.0",
  "description": "System-agnostic combat engine for UrsaMU \u2014 encounters, turn walker, JSON AI brains, and ports for game systems.",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "test": "deno test tests/ --allow-all --unstable-kv --no-check",
    "lint": "deno lint",
    "check": "deno check mod.ts --unstable-kv",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types --no-check"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "@ursamu/mush": "jsr:@ursamu/mush@^0.1.3",
    "@ursamu/core": "jsr:@ursamu/core@^0.1.0",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/path": "jsr:@std/path@^0.224.0"
  },
  "publish": {
    "include": [
      "src",
      "resources",
      "mod.ts",
      "index.ts",
      "deno.json",
      "README.md"
    ],
    "exclude": [
      "tests"
    ]
  }
}