{
  "key": "modern-chargen",
  "label": "+cg -- Guided d20 Modern Character Generation",
  "description": "Walks through guided character creation (+cg) for d20 Modern.",
  "vars": { "player": "Marcus" },
  "steps": [
    { "sub": "Stage 1: Choose Occupation" },
    { "cmd": "+cg", "label": "Start chargen" },
    { "expect": "STAGE 1" },
    { "cmd": "+cg/list occupations", "label": "List occupations" },
    { "expect": "academic" },
    { "cmd": "+cg/set occupation=academic", "label": "Set occupation" },
    { "expect": "academic" },
    { "cmd": "+cg/next", "label": "Advance to Stage 2" },
    { "expect": "STAGE 2" },

    { "sub": "Stage 2: Choose Hero Class" },
    { "cmd": "+cg/set class=strong", "label": "Set class to Strong" },
    { "expect": "strong" },
    { "cmd": "+cg/next", "label": "Advance to Stage 3" },
    { "expect": "STAGE 3" },

    { "sub": "Stage 3: Determine Ability Scores" },
    { "cmd": "+cg/set strength=15", "label": "Set strength to 15 (8 pts)" },
    { "expect": "strength" },
    { "cmd": "+cg/set dexterity=14", "label": "Set dexterity to 14 (6 pts)" },
    { "expect": "dexterity" },
    { "cmd": "+cg/set constitution=13", "label": "Set constitution to 13 (5 pts)" },
    { "expect": "constitution" },
    { "cmd": "+cg/set intelligence=12", "label": "Set intelligence to 12 (4 pts)" },
    { "expect": "intelligence" },
    { "cmd": "+cg/set wisdom=10", "label": "Set wisdom to 10 (2 pts)" },
    { "expect": "wisdom" },
    { "cmd": "+cg/set charisma=8", "label": "Set charisma to 8 (0 pts)" },
    { "expect": "charisma" },
    { "cmd": "+cg/next", "label": "Advance to Stage 4" },
    { "expect": "STAGE 4" },

    { "sub": "Stage 4: Choose Class Talent" },
    { "cmd": "+cg/set talent=melee_smash", "label": "Select Melee Smash" },
    { "expect": "melee_smash" },
    { "cmd": "+cg/next", "label": "Advance to Stage 5" },
    { "expect": "STAGE 5" },

    { "sub": "Stage 5: Skill Selection" },
    { "cmd": "+cg/list skills", "label": "List skills" },
    { "expect": "athletics" },
    { "cmd": "+cg/set skill=athletics", "label": "Select Athletics" },
    { "expect": "athletics" },
    { "cmd": "+cg/next", "label": "Advance to Stage 6" },
    { "expect": "STAGE 6" },

    { "sub": "Stage 6: Starting Feats" },
    { "cmd": "+cg/list feats", "label": "List feats" },
    { "expect": "brawl" },
    { "cmd": "+cg/set feat=brawl", "label": "Select Brawl" },
    { "expect": "brawl" },
    { "cmd": "+cg/next", "label": "Advance to Stage 7" },
    { "expect": "STAGE 7" },

    { "sub": "Stage 7: Allegiances" },
    { "cmd": "+cg/set allegiance=good", "label": "Select Good Allegiance" },
    { "expect": "good" },
    { "cmd": "+cg/set allegiance=lawful", "label": "Select Lawful Allegiance" },
    { "expect": "lawful" },
    { "cmd": "+cg/next", "label": "Advance to Stage 8" },
    { "expect": "STAGE 8" },

    { "sub": "Stage 8: Review & Submit" },
    { "cmd": "+cg/submit", "label": "Submit chargen" },
    { "expect": "completed" },

    { "sub": "Viewing Character Sheet" },
    { "cmd": "+sheet", "label": "View sheet" },
    { "expect": "D20 MODERN CHARACTER SHEET" },

    { "sub": "Rolling Dice" },
    { "cmd": "+roll strength", "label": "Roll strength check" },
    { "expect": "strength check" },
    { "cmd": "+roll/ap athletics", "label": "Roll with action points" },
    { "expect": "athletics check" }
  ]
}
