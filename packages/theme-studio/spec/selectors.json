{
  "specVersion": "1.0.0",
  "description": "CSS selector allowlist for theme cssExtras and Grapes export",
  "stableClasses": [
    ".site-shell",
    ".site-nav",
    ".site-nav__brand",
    ".site-nav__list",
    ".site-nav__toggle",
    ".site-banner",
    ".site-banner__title",
    ".site-banner__img",
    ".site-banner__connect",
    ".site-body",
    ".site-aside",
    ".site-aside--start",
    ".site-aside--end",
    ".site-main",
    ".site-search",
    ".site-search__input",
    ".site-search__btn",
    ".site-menu",
    ".site-menu__title",
    ".site-menu__list",
    ".site-section",
    ".site-section__title",
    ".site-section__body",
    ".site-rule",
    ".site-rule--image",
    ".site-footer",
    ".site-badge",
    ".site-gate",
    ".site-gate-card",
    ".site-gate-btn",
    ".site-gate-btn--primary",
    ".site-auth-tab",
    ".site-auth-input",
    ".site-auth-submit",
    ".site-auth-error",
    ".site-wiki-table",
    ".site-wiki-open-link",
    ".site-help-body",
    ".site-help-crumb",
    ".site-help-open-link",
    ".play-prompt",
    ".play-prompt__input",
    ".play-prompt__send",
    ".play-chat",
    ".play-chat__name",
    ".play-chat__text",
    ".play-chat__tag",
    ".play-chat__tag--ooc"
  ],
  "allowSelectorPatterns": [
    "^\\.site-[a-z0-9_-]+(\\.[a-z0-9_-]+|__?[a-z0-9_-]+|--[a-z0-9_-]+|\\s+\\.[a-z0-9_-]+|:[a-z-]+|::[a-z-]+|\\[.*?\\])*$",
    "^\\.play-[a-z0-9_-]+(\\.[a-z0-9_-]+|__?[a-z0-9_-]+|--[a-z0-9_-]+|\\s+\\.[a-z0-9_-]+|:[a-z-]+|::[a-z-]+|\\[.*?\\])*$",
    "^\\.site-section__body\\s+(h[1-6]|p|a|ul|ol|li|blockquote|pre|code|table|thead|tbody|tr|th|td|hr|img)(:[a-z-]+)?$",
    "^\\.site-section__body\\s+(h[1-6]|p|a|ul|ol|li|blockquote|pre|code|table|th|td)\\s+[a-z0-9_.#:\\[\\]-]+$"
  ],
  "allowAtRules": ["font-face"],
  "forbiddenSubstring": [
    "@import",
    "expression(",
    "behavior:",
    "-moz-binding",
    "javascript:",
    "vbscript:"
  ],
  "forbiddenSelectorPatterns": [
    "^html\\b",
    "^body\\b",
    "^\\*$",
    "^:root\\b"
  ],
  "notes": [
    "Themes may style allowlisted .site-* / .play-* classes only.",
    "Do not replace shell structure or invent competing layout roots.",
    ":root token block is generated separately — not via cssExtras."
  ]
}
