{
  "name": "@ursamu/wiki",
  "version": "0.2.8",
  "description": "File-based markdown wiki for UrsaMU (staff UI via @ursamu/web).",
  "license": "MIT",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test tests/ --allow-all --unstable-kv --no-check",
    "lint": "deno lint",
    "check": "deno check mod.ts --unstable-kv",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types --no-check",
    "publish": "deno publish --allow-slow-types --no-check"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@ursamu/mush": "jsr:@ursamu/mush@^1.0.0",
    "imagescript": "npm:imagescript@1.3.0"
  },
  "publish": {
    "include": [
      "src",
      "admin",
      "mod.ts",
      "index.ts",
      "deno.json",
      "README.md",
      "design.md",
      "LICENSE",
      "CHANGELOG.md"
    ],
    "exclude": [
      "tests"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
