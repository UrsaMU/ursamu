{
  "name": "@ursamu/vendor-plugin",
  "version": "1.1.0",
  "description": "Shop + grab-stall vendor plugin for UrsaMU.",
  "exports": "./index.ts",
  "tasks": {
    "test": "deno test -A --unstable-kv",
    "check": "deno check index.ts commands.ts grab.ts helpers.ts purchase.ts types.ts"
  },
  "publish": {
    "include": [
      "index.ts",
      "mod.ts",
      "commands.ts",
      "grab.ts",
      "helpers.ts",
      "purchase.ts",
      "catalog.ts",
      "types.ts",
      "deno.json",
      "ursamu.plugin.json",
      "README.md"
    ],
    "exclude": [
      "tests"
    ]
  },
  "imports": {
    "ursamu": "../mush/mod.ts",
    "@ursamu/ursamu": "../mush/mod.ts",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.17/bdd",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/fs": "jsr:@std/fs@^0.224.0"
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any", "no-unused-vars"]
    }
  }
}

