{
  "name": "@ursamu/wod20th",
  "version": "1.1.0",
  "description": "World of Darkness 20th multi-template plugin for UrsaMU (VtM, WtA, Mortal, Kinfolk).",
  "license": "MIT",
  "exports": "./index.ts",
  "tasks": {
    "test": "deno test tests/ -A --unstable-kv --no-check --import-map=import_map.local.json",
    "check": "deno check --unstable-kv --import-map=import_map.local.json index.ts",
    "lint": "deno lint",
    "showcase": "deno run -A --unstable-kv --import-map=import_map.local.json tools/showcase.ts",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types --no-check",
    "publish": "deno publish --allow-slow-types --no-check"
  },
  "imports": {
    "ursamu": "jsr:@ursamu/mush@^1.0.39",
    "@ursamu/mush": "jsr:@ursamu/mush@^1.0.39",
    "@ursamu/ursamu": "jsr:@ursamu/mush@^1.0.39",
    "@ursamu/core": "jsr:@ursamu/core@^1.0.6",
    "@ursamu/help": "jsr:@ursamu/help@^1.3.1",
    "@ursamu/help/register": "jsr:@ursamu/help@^1.3.1/register",
    "@ursamu/help-plugin": "jsr:@ursamu/help@^1.3.1",
    "@ursamu/mushcode": "jsr:@ursamu/mushcode@^0.7.0",
    "@ursamu/mushcode/eval": "jsr:@ursamu/mushcode@^0.7.0/eval",
    "@ursamu/mushcode/parse": "jsr:@ursamu/mushcode@^0.7.0/parse",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/flags": "jsr:@std/flags@^0.224.0",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.0/bdd",
    "djwt": "jsr:@zaubrik/djwt@^3.0.2"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": [".claude/", "resources/"]
  },
  "fmt": {
    "indentWidth": 2,
    "singleQuote": false,
    "exclude": [".claude/", "resources/"]
  },
  "publish": {
    "include": [
      "index.ts",
      "commands.ts",
      "hooks.ts",
      "integrations.ts",
      "router.ts",
      "statSystem.ts",
      "ursamu.plugin.json",
      "commands",
      "core",
      "db",
      "data",
      "splats",
      "help",
      "deno.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests",
      "tools",
      "showcases",
      "resources",
      "config",
      "import_map.local.json"
    ]
  }
}
