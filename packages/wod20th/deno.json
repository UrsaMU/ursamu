{
  "name": "@ursamu/wod20th",
  "version": "1.1.0",
  "description": "World of Darkness 20th multi-template plugin for UrsaMU (VtM, WtA, Mortal, Kinfolk).",
  "exports": "./index.ts",
  "tasks": {
    "test": "deno test tests/ -A --unstable-kv --no-check",
    "check": "deno check --unstable-kv index.ts",
    "lint": "deno lint",
    "showcase": "deno run -A --unstable-kv tools/showcase.ts"
  },
  "imports": {
    "ursamu": "../mush/mod.ts",
    "@ursamu/mush": "../mush/mod.ts",
    "@ursamu/ursamu": "../mush/mod.ts",
    "@ursamu/core": "../core/mod.ts",
    "@ursamu/mushcode": "jsr:@ursamu/mushcode@^0.7.0",
    "@ursamu/help": "../help/mod.ts",
    "@ursamu/help/register": "../help/register.ts",
    "@ursamu/events": "../events/mod.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/flags": "jsr:@std/flags@^0.224.0",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.0/bdd",
    "@ursamu/globals": "../../../ursamu-sgp-plugin/mod.ts",
    "@nicia-ai/typegraph": "npm:@nicia-ai/typegraph@^0.31.0",
    "@nicia-ai/typegraph/postgres/pglite": "npm:@nicia-ai/typegraph@^0.31.0/postgres/pglite",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.5.2",
    "zod": "npm:zod@4.4.3",
    "djwt": "jsr:@zaubrik/djwt@^3.0.2",
    "@ursamu/mushcode/eval": "jsr:@ursamu/mushcode@^0.7.0/eval",
    "@ursamu/mushcode/parse": "jsr:@ursamu/mushcode@^0.7.0/parse"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "exclude": [
      ".claude/",
      "data/",
      "resources/"
    ]
  },
  "fmt": {
    "indentWidth": 2,
    "singleQuote": false,
    "exclude": [
      ".claude/",
      "data/",
      "resources/"
    ]
  },
  "publish": {
    "include": [
      "index.ts",
      "commands.ts",
      "hooks.ts",
      "integrations.ts",
      "router.ts",
      "statSystem.ts",
      "ursamu.plugin.json",
      "commands",
      "core",
      "db",
      "data",
      "splats",
      "help",
      "deno.json",
      "README.md"
    ],
    "exclude": [
      "tests",
      "tools",
      "showcases",
      "resources"
    ]
  }
}
