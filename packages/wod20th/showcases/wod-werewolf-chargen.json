{
  "key": "wod-werewolf-chargen",
  "label": "WoD20th -- Werewolf (Garou) Character Generation",
  "plugin": "wod20th",
  "vars": { "player": "Storms" },
  "steps": [
    { "sub": "Starting Chargen" },
    { "note": "Garou is a Shifter subtype -- two-step template selection." },
    { "cmd": "+chargen", "label": "show template picker", "as": "player" },
    { "cmd": "+chargen/template shifter", "label": "show shifter subtype picker", "as": "player" },
    { "cmd": "+chargen/template shifter/garou", "label": "start chargen as Garou", "as": "player" },
    { "cmd": "+chargen", "label": "view dashboard / current step", "as": "player" },

    { "sub": "Step 1 -- Sub-template (Breed / Auspice / Tribe)" },
    { "note": "Setting breed/auspice/tribe auto-seeds Rage, Gnosis, Willpower from splat tables." },
    { "cmd": "+chargen/set breed=homid", "label": "Homid breed (Gnosis 1)", "as": "player" },
    { "cmd": "+chargen/set auspice=theurge", "label": "Theurge auspice (Rage 2, Wisdom renown 3)", "as": "player" },
    { "cmd": "+chargen/set tribe=Wendigo", "label": "Wendigo tribe (Willpower 4)", "as": "player" },

    { "sub": "Step 2 -- Concept" },
    { "cmd": "+chargen/set fullName=Maya Whitehorse", "label": "set full name", "as": "player" },
    { "cmd": "+chargen/set age=24", "label": "set age", "as": "player" },
    { "cmd": "+chargen/set concept=Wandering Theurge", "label": "set concept", "as": "player" },
    { "cmd": "+chargen/set nature=Visionary", "label": "Nature archetype", "as": "player" },
    { "cmd": "+chargen/set demeanor=Loner", "label": "Demeanor archetype", "as": "player" },

    { "sub": "Step 3 -- Attributes" },
    { "note": "7/5/3 dots over base-1, one trait per command." },
    { "cmd": "+chargen/priority attrs=physical/mental/social", "label": "Physical primary", "as": "player" },
    { "cmd": "+chargen/set Strength=2", "label": "Strength 1+2=3", "as": "player" },
    { "cmd": "+chargen/set Dexterity=3", "label": "Dexterity 1+3=4", "as": "player" },
    { "cmd": "+chargen/set Stamina=2", "label": "Stamina 1+2=3 (physical: 7)", "as": "player" },
    { "cmd": "+chargen/set Perception=2", "label": "Perception 1+2=3", "as": "player" },
    { "cmd": "+chargen/set Intelligence=1", "label": "Intelligence 1+1=2", "as": "player" },
    { "cmd": "+chargen/set Wits=2", "label": "Wits 1+2=3 (mental: 5)", "as": "player" },
    { "cmd": "+chargen/set Charisma=1", "label": "Charisma 1+1=2", "as": "player" },
    { "cmd": "+chargen/set Manipulation=1", "label": "Manipulation 1+1=2", "as": "player" },
    { "cmd": "+chargen/set Appearance=1", "label": "Appearance 1+1=2 (social: 3)", "as": "player" },

    { "sub": "Step 4 -- Abilities" },
    { "cmd": "+chargen/priority abilities=talents/skills/knowledges", "label": "Talents primary", "as": "player" },
    { "cmd": "+chargen/set Alertness=3", "label": "Alertness 3", "as": "player" },
    { "cmd": "+chargen/set Brawl=3", "label": "Brawl 3", "as": "player" },
    { "cmd": "+chargen/set Athletics=2", "label": "Athletics 2", "as": "player" },
    { "cmd": "+chargen/set Primal-Urge=3", "label": "Primal-Urge 3", "as": "player" },
    { "cmd": "+chargen/set Empathy=2", "label": "Empathy 2 (talents: 13)", "as": "player" },
    { "cmd": "+chargen/set Stealth=3", "label": "Stealth 3", "as": "player" },
    { "cmd": "+chargen/set Survival=3", "label": "Survival 3", "as": "player" },
    { "cmd": "+chargen/set Melee=2", "label": "Melee 2", "as": "player" },
    { "cmd": "+chargen/set Animal-Ken=1", "label": "Animal-Ken 1 (skills: 9)", "as": "player" },
    { "cmd": "+chargen/set Occult=2", "label": "Occult 2", "as": "player" },
    { "cmd": "+chargen/set Rituals=2", "label": "Rituals 2", "as": "player" },
    { "cmd": "+chargen/set Enigmas=1", "label": "Enigmas 1 (knowledges: 5)", "as": "player" },

    { "sub": "Step 5 -- Advantages (Backgrounds, Gifts, Merits, Flaws)" },
    { "note": "Werewolves get 5 background dots. Wendigo discourages Contacts/Resources." },
    { "cmd": "+chargen/set Pure Breed=2", "label": "2 dots Pure Breed", "as": "player" },
    { "cmd": "+chargen/set Totem=2", "label": "2 dots Totem", "as": "player" },
    { "cmd": "+chargen/set Mentor=1", "label": "1 dot Mentor (5 total)", "as": "player" },

    { "note": "Each Garou starts with 1 Level-1 gift from each of breed / auspice / tribe. Set by name; slot is auto." },
    { "cmd": "+chargen/giftlist", "label": "browse starting gift pools", "as": "player" },
    { "cmd": "+chargen/set gift=Persuasion", "label": "Homid gift: Persuasion", "as": "player" },
    { "cmd": "+chargen/set gift=Mother's Touch", "label": "Theurge gift", "as": "player" },
    { "cmd": "+chargen/set gift=Call the Breeze", "label": "Wendigo gift", "as": "player" },

    { "cmd": "+chargen/meritlist supernatural", "label": "browse supernatural merits", "as": "player" },
    { "cmd": "+chargen/set merit=Acute Sense", "label": "buy a Physical merit (1pt)", "as": "player" },
    { "cmd": "+chargen/set flaw=Curiosity", "label": "take Curiosity (+1 freebies)", "as": "player" },

    { "sub": "Step 6 -- Freebies" },
    { "note": "Garou get 15 freebies. Costs: attr 5, ability 2, background 1, gift 7, rage 1, gnosis 2, willpower 1." },
    { "cmd": "+chargen/spend Rage=2", "label": "+2 Rage (2 pts)", "as": "player" },
    { "cmd": "+chargen/spend Gnosis=2", "label": "+2 Gnosis (4 pts)", "as": "player" },
    { "cmd": "+chargen/spend Willpower=3", "label": "+3 Willpower (3 pts)", "as": "player" },
    { "cmd": "+chargen/spend Willpower=2", "label": "+2 more Willpower (2 pts)", "as": "player" },
    { "cmd": "+chargen/unspend Willpower", "label": "back out last Willpower", "as": "player" },
    { "cmd": "+chargen/spend Willpower=2", "label": "spend it again (2 pts)", "as": "player" },
    { "cmd": "+chargen/freebies", "label": "review freebie ledger", "as": "player" },
    { "note": "/done closes freebies only (keep leftover). /submit is the real finish." },
    { "cmd": "+chargen/done", "label": "close freebie step (not submit)", "as": "player" },

    { "sub": "Notes" },
    { "cmd": "+notes/set pack=Maya seeks her vanished pack in the badlands.", "label": "private pack note", "as": "player" },
    { "cmd": "+notes/public pack", "label": "share with staff", "as": "player" },

    { "sub": "Submission" },
    { "cmd": "+chargen", "label": "review dashboard (How to finish)", "as": "player" },
    { "cmd": "+chargen/submit", "label": "submit for staff approval", "as": "player" },

    { "sub": "Staff Review" },
    { "cmd": "+chargen/queue", "label": "list submitted characters", "as": "admin" },
    { "cmd": "+chargen/note Storms=Solid Theurge concept; cleared.", "label": "add staff note", "as": "admin" },
    { "cmd": "+chargen/approve Storms", "label": "approve the character", "as": "admin" },

    { "sub": "Reset (Admin)" },
    { "note": "Showcase complete -- state cleared." },
    { "reset": true }
  ]
}
