    { "sub": "Initiative + auto-AI turns" },
    { "cmd": "+init",                                    "label": "PC rolls init",   "as": "staff" },
    { "cmd": "+init/addnpc Bane-Roach",                  "label": "NPC1 in order",   "as": "staff" },
    { "cmd": "+init/addnpc Krunzh the Spent",            "label": "NPC2 in order",   "as": "staff" },
