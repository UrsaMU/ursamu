    { "cmd": "+init/next",                               "label": "advance; NPC turns auto-fire", "as": "staff" },

    { "sub": "Manual single-NPC drive" },
    { "cmd": "+npc/act Krunzh the Spent",                "label": "force one AI turn", "as": "staff" },

    { "sub": "Despawn" },
    { "cmd": "+npc/despawn Bane-Roach",                  "label": "remove from world", "as": "staff" },
    { "cmd": "+npc/here",                                "label": "one left",          "as": "staff" }
