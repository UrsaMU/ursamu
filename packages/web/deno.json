{
  "name": "@ursamu/web",
  "version": "0.2.73",
  "description": "Staff web console for UrsaMU \u2014 wiki, database, and more.",
  "license": "MIT",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test tests/ --allow-all --unstable-kv --no-check",
    "lint": "deno lint",
    "check": "deno check mod.ts --unstable-kv",
    "ui:dev": "cd ui && npm run dev",
    "ui:build": "cd ui && npm run build:fast",
    "ui:install": "cd ui && npm install",
    "theme:sync": "deno run -A ./scripts/sync-staff-theme.ts",
    "import-plugin": "deno run -A ./scripts/import-plugin.ts",
    "preflight:ui": "deno run -A ./scripts/preflight-ui.ts",
    "example:host-module": "cd examples/host-module && npm run build",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types --no-check",
    "publish": "deno publish --allow-slow-types --no-check"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@ursamu/mush": "jsr:@ursamu/mush@^1.0.0",
    "@ursamu/site": "jsr:@ursamu/site@^0.1.5",
    "@ursamu/wiki": "jsr:@ursamu/wiki@^0.2.2",
    "@ursamu/jobs": "jsr:@ursamu/jobs@^1.1.2"
  },
  "publish": {
    "include": [
      "src",
      "dist",
      "admin",
      "mod.ts",
      "deno.json",
      "README.md",
      "design.md",
      "LICENSE"
    ],
    "exclude": [
      "tests",
      "ui/node_modules"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
