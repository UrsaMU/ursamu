{
  "key": "look-conformat",
  "title": "+look -- room, player inventory, and concealment",
  "description": "CoFD CONFORMAT: room occupants with short-descs, floor loot, open-carry vs concealed gear on people, wielded/worn tags.",
  "vars": { "player": "Alice" },
  "setup": {
    "character": {
      "state": {
        "moniker": "Alice",
        "attributes": [
          {
            "name": "short-desc",
            "value": "A smart detective in a beige coat."
          }
        ]
      }
    },
    "targets": {
      "Bob": {
        "flags": ["player", "connected"],
        "location": "mock-room",
        "state": {
          "name": "Bob",
          "name_color": "%cg",
          "description": "A tall, rugged ranger.",
          "attributes": [
            {
              "name": "short-desc",
              "value": "A tall, rugged ranger."
            }
          ],
          "cofd": {
            "equipment": {
              "equippedWeapon": "mock-combat-knife",
              "equippedArmor": null
            }
          }
        }
      },
      "Iron Sword": {
        "flags": ["thing"],
        "location": "mock-room",
        "state": {
          "name": "Iron Sword",
          "description": "A finely crafted blade of cold iron, perfectly balanced.",
          "attributes": [
            {
              "name": "short-desc",
              "value": "A finely balanced cold-iron blade."
            }
          ],
          "cofd_item": {
            "key": "sword",
            "kind": "weapon",
            "customLabel": "Iron Sword"
          }
        }
      },
      "Combat Knife": {
        "flags": ["thing", "dark"],
        "location": "mock-bob",
        "state": {
          "name": "Combat Knife",
          "cofd_item": {
            "key": "knife",
            "kind": "weapon",
            "customLabel": "Combat Knife",
            "equippedBy": "mock-bob"
          }
        }
      },
      "Flashlight": {
        "flags": ["thing"],
        "location": "mock-bob",
        "state": {
          "name": "Flashlight",
          "cofd_item": {
            "key": "flashlight",
            "kind": "gear",
            "customLabel": "Flashlight"
          }
        }
      },
      "Light Pistol": {
        "flags": ["thing"],
        "location": "mock-bob",
        "state": {
          "name": "Light Pistol",
          "concealed": true,
          "cofd_item": {
            "key": "pistol-light",
            "kind": "weapon",
            "currentClip": 15,
            "customLabel": "Pistol, Light"
          }
        }
      },
      "Spare Mag": {
        "flags": ["thing", "dark"],
        "location": "mock-bob",
        "state": {
          "name": "Spare Mag",
          "cofd_item": {
            "key": "magazine-9mm-light",
            "kind": "ammo",
            "count": 15,
            "customLabel": "Light Pistol Mag"
          }
        }
      }
    },
    "room": {
      "name": "OOC Polis",
      "desc": "A quiet, dimly lit room in the city, smelling of paper and old books.",
      "exits": [
        {
          "name": "North;n",
          "description": "A dark pathway leading north towards the archives."
        }
      ]
    }
  },
  "steps": [
    { "sub": "Looking at the Room" },
    {
      "note": "Players: idle + short-desc. Floor things: classic short-desc flavor. Floor loot is never (wielded). Inventory on people: name/tags only."
    },
    { "cmd": "look", "label": "look at room" },
    { "expect": "OOC Polis" },
    { "expect": "Players" },
    { "expect": "ranger" },
    { "expect": "Contents" },
    { "expect": "Iron Sword" },
    { "expect": "cold-iron blade" },
    { "expect": "Exits" },
    { "expect": "North" },

    { "sub": "Looking at a Player (stranger)" },
    {
      "note": "Alice looks at Bob. Full description + open-carry and wielded gear. Concealed and bagged dark items stay hidden."
    },
    { "cmd": "look Bob", "label": "look at bob as stranger" },
    { "expect": "Bob" },
    { "expect": "A tall, rugged ranger." },
    { "expect": "Flashlight" },
    { "expect": "Combat Knife" },
    { "expect": "wielded" },
    {
      "note": "Concealed pistol and spare mag must not appear for a stranger."
    },

    { "sub": "Looking at a Player (self)" },
    {
      "note": "Bob looks at himself. Concealed inventory shows with [concealed]."
    },
    {
      "cmd": "look Bob",
      "as": "Bob",
      "label": "look at self"
    },
    { "expect": "Flashlight" },
    { "expect": "Combat Knife" },
    { "expect": "wielded" },
    { "expect": "Pistol, Light" },
    { "expect": "concealed" },
    { "expect": "Light Pistol Mag" },

    { "sub": "Looking at a Thing" },
    {
      "note": "Looking at a thing uses its full description attribute."
    },
    { "cmd": "look Iron Sword", "label": "look at weapon" },
    { "expect": "Iron Sword" },
    { "expect": "finely crafted blade" },

    { "sub": "Looking at an Exit" },
    {
      "note": "Looking at an exit displays its alias and description."
    },
    { "cmd": "look North", "label": "look at exit" },
    { "expect": "North" },
    { "expect": "dark pathway leading north" }
  ]
}
