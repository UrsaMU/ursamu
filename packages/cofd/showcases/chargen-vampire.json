{
  "key": "chargen-vampire",
  "title": "+cg -- guided Vampire: The Requiem character generation",
  "description": "Full guided chargen for Vampire: The Requiem 2e: Core Identity, Template, Clan/Covenant/Touchstone + Mask/Dirge, Attributes (5/4/3), Skills (11/9/7), Merits (10 dots), Disciplines (3 dots, ≥2 in-clan) — then submit for staff approval.",
  "vars": { "player": "Novice" },
  "steps": [
    { "sub": "Browsing Clans Before Starting" },
    { "note": "Clan/covenant lists unlock after template=vampire. Templates list is open anytime." },
    { "cmd": "+cg/list templates",                           "label": "browse templates" },
    { "expect": "vampire" },

    { "sub": "Starting Vampire Character Generation" },
    { "cmd": "+cg",                                          "label": "start chargen" },
    { "expect": "Stage" },

    { "sub": "Stage 1 -- Core Identity" },
    { "note": "Mortals use Virtue/Vice first; after template=vampire, set Mask/Dirge in Stage 3." },
    { "cmd": "+cg/set concept=Neonatal club owner",          "label": "set concept" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/set virtue=Just",                          "label": "placeholder virtue" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/set vice=Greedy",                          "label": "placeholder vice" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/next",                                     "label": "advance to Stage 2" },
    { "expect": "Stage" },

    { "sub": "Stage 2 -- Template" },
    { "cmd": "+cg/set template=vampire",                     "label": "Vampire: The Requiem" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/next",                                     "label": "advance to Stage 3" },
    { "expect": "Stage" },

    { "sub": "Stage 3 -- Clan, Covenant, Mask/Dirge" },
    { "note": "Clan + Covenant + Touchstone required. Bloodline optional. Mask/Dirge replace Virtue/Vice." },
    { "cmd": "+cg/list clans",                               "label": "browse clans" },
    { "expect": "Daeva" },
    { "cmd": "+cg/list clans Daeva",                         "label": "drilldown: Daeva" },
    { "expect": "Majesty" },
    { "cmd": "+cg/list covenants",                           "label": "browse covenants" },
    { "expect": "Invictus" },
    { "cmd": "+cg/list masks",                               "label": "browse Mask/Dirge" },
    { "expect": "Authoritarian" },
    { "cmd": "+cg/set clan=Daeva",                           "label": "set clan" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/set covenant=Invictus",                    "label": "set covenant" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/set touchstone=My sister Elena",           "label": "set touchstone" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/set mask=Courtesan",                       "label": "set Mask" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/set dirge=Survivor",                       "label": "set Dirge" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/next",                                     "label": "advance to Stage 4" },
    { "expect": "Stage" },

    { "sub": "Stage 4 -- Attributes (5/4/3 priority)" },
    { "cmd": "+cg/set presence=3",      "label": "Social priority (+5)" },
    { "cmd": "+cg/set manipulation=3" },
    { "cmd": "+cg/set composure=2" },
    { "cmd": "+cg/set intelligence=2",  "label": "Mental secondary (+4)" },
    { "cmd": "+cg/set wits=3" },
    { "cmd": "+cg/set resolve=2" },
    { "cmd": "+cg/set strength=2",      "label": "Physical tertiary (+3)" },
    { "cmd": "+cg/set dexterity=2" },
    { "cmd": "+cg/set stamina=2" },
    { "cmd": "+cg/next",                "label": "advance to Stage 5" },
    { "expect": "Stage" },

    { "sub": "Stage 5 -- Skills (11/9/7 priority)" },
    { "cmd": "+cg/set persuasion=3",     "label": "Social group (11)" },
    { "cmd": "+cg/set socialize=3" },
    { "cmd": "+cg/set subterfuge=3" },
    { "cmd": "+cg/set empathy=2" },
    { "cmd": "+cg/set athletics=3",      "label": "Physical group (9)" },
    { "cmd": "+cg/set brawl=2" },
    { "cmd": "+cg/set stealth=2" },
    { "cmd": "+cg/set larceny=2" },
    { "cmd": "+cg/set academics=2",      "label": "Mental group (7)" },
    { "cmd": "+cg/set investigation=2" },
    { "cmd": "+cg/set occult=2" },
    { "cmd": "+cg/set computer=1" },
    { "cmd": "+cg/next",                 "label": "advance to Stage 6" },
    { "expect": "Stage" },

    { "sub": "Stage 6 -- Merits (10 dots)" },
    { "note": "Vampires start with 10 Merit dots (not 7)." },
    { "cmd": "+cg/set resources=3",           "label": "resources" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/set contacts(club)=2",      "label": "instanced contacts" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/set striking looks=2",      "label": "striking looks" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/set status(city)=2",        "label": "status" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/set language(french)=1",    "label": "language" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/next",                      "label": "advance to Stage 7" },
    { "expect": "Stage 7" },

    { "sub": "Stage 7 -- Disciplines (3 dots, ≥2 in-clan)" },
    { "note": "Daeva in-clan: Celerity, Majesty, Vigor. Put at least 2 dots there." },
    { "cmd": "+cg/list disciplines",                     "label": "browse Disciplines" },
    { "expect": "Majesty" },
    { "cmd": "+cg/set majesty=2",                        "label": "in-clan Majesty 2" },
    { "expect": "Successfully set" },
    { "cmd": "+cg/set celerity=1",                       "label": "in-clan Celerity 1" },
    { "expect": "Successfully set" },
    { "cmd": "+cg",                                      "label": "view Stage 7 screen" },
    { "expect": "Stage 7" },

    { "sub": "Submit for Staff Approval" },
    { "cmd": "+cg/submit",  "label": "submit for review" },
    { "expect": "Submitted" }
  ]
}
