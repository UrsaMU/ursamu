{
  "name": "@ursamu/cofd-plugin",
  "version": "1.1.5",
  "description": "Chronicles of Darkness 2e plugin for UrsaMU \u2014 character sheets, guided chargen, and d10 dice with 10/9/8-again, rote, and Willpower spend.",
  "exports": "./index.ts",
  "tasks": {
    "test": "deno test -A --unstable-kv",
    "showcase": "deno run -A --unstable-kv tools/showcase.ts",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types"
  },
  "exclude": [
    ".claude/",
    "data/"
  ],
  "publish": {
    "include": [
      "src",
      "help",
      "resources",
      "templates",
      "index.ts",
      "commands.ts",
      "cofd.ts",
      "cg.ts",
      "templates.ts",
      "routes.ts",
      "deno.json",
      "ursamu.plugin.json",
      "README.md"
    ],
    "exclude": [
      "tests",
      "tools",
      "showcases",
      "docs"
    ]
  },
  "imports": {
    "ursamu": "jsr:@ursamu/mush@^0.1.11",
    "@ursamu/ursamu": "jsr:@ursamu/mush@^0.1.11",
    "@ursamu/mush": "jsr:@ursamu/mush@^0.1.11",
    "@ursamu/combat": "jsr:@ursamu/combat@^0.8.0",
    "@ursamu/core": "jsr:@ursamu/core@^0.1.1",
    "@ursamu/help-plugin": "jsr:@ursamu/help@^0.1.3",
    "@ursamu/help": "jsr:@ursamu/help@^0.1.3",
    "@ursamu/jobs-plugin": "jsr:@ursamu/jobs@^0.1.1",
    "@ursamu/jobs": "jsr:@ursamu/jobs@^0.1.1",
    "@ursamu/mail": "jsr:@ursamu/mail@^2.4.0",
    "@ursamu/mail-plugin": "jsr:@ursamu/mail@^2.4.0",
    "@ursamu/globals": "./tests/helpers/globals-shim.ts",
    "@ursamu/mushcode": "jsr:@ursamu/mush@^0.1.11",
    "@ursamu/mushcode/eval": "jsr:@ursamu/mush@^0.1.11",
    "@ursamu/mushcode/parse": "jsr:@ursamu/mush@^0.1.11",
    "@ursamu/parser": "npm:@ursamu/parser@1.2.4",
    "@digibear/tags": "npm:@digibear/tags@1.0.0",
    "bcrypt": "npm:bcryptjs@2.4.3",
    "djwt": "jsr:@zaubrik/djwt@^3.0.2",
    "dotenv": "jsr:@std/dotenv@^0.224.0",
    "dotenv/": "jsr:@std/dotenv@^0.224.0/",
    "dotenv/load": "jsr:@std/dotenv@^0.224.0/load",
    "@std/dotenv": "jsr:@std/dotenv@^0.224.0",
    "@std/dotenv/": "jsr:@std/dotenv@^0.224.0/",
    "quickjs-emscripten": "npm:quickjs-emscripten@0.29.0",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/testing/bdd": "jsr:@std/testing@^0.224.0/bdd",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@std/flags": "jsr:@std/flags@^0.224.0",
    "@std/semver": "jsr:@std/semver@^1.0.0",
    "@std/fmt": "jsr:@std/fmt@^0.224.0",
    "@std/fmt/": "jsr:@std/fmt@^0.224.0/"
  }
}
