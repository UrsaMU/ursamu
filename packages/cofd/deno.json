{
  "name": "@ursamu/cofd-plugin",
  "version": "1.2.11",
  "description": "Chronicles of Darkness 2e plugin for UrsaMU \u2014 sheets, chargen, d10 dice, IC/OOC, +time, CtL overlay.",
  "license": "MIT",
  "exports": "./index.ts",
  "tasks": {
    "test": "deno test -A --unstable-kv --no-check",
    "showcase": "deno run -A --unstable-kv tools/showcase.ts",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types --no-check",
    "publish": "deno publish --allow-slow-types --no-check"
  },
  "exclude": [
    ".claude/",
    "data/",
    "books/"
  ],
  "publish": {
    "include": [
      "src",
      "help",
      "resources",
      "templates",
      "index.ts",
      "commands.ts",
      "cofd.ts",
      "cg.ts",
      "templates.ts",
      "routes.ts",
      "deno.json",
      "ursamu.plugin.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE"
    ],
    "exclude": [
      "tests",
      "tools",
      "showcases",
      "docs",
      "books"
    ]
  },
  "imports": {
    "ursamu": "../mush/mod.ts",
    "@ursamu/ursamu": "../mush/mod.ts",
    "@ursamu/mush": "../mush/mod.ts",
    "@ursamu/combat": "../combat/mod.ts",
    "@ursamu/core": "../core/mod.ts",
    "@ursamu/help-plugin": "../help/mod.ts",
    "@ursamu/help": "../help/mod.ts",
    "@ursamu/jobs-plugin": "../jobs/mod.ts",
    "@ursamu/jobs": "../jobs/mod.ts",
    "@ursamu/mail": "../mail/mod.ts",
    "@ursamu/mail-plugin": "../mail/mod.ts",
    "@ursamu/globals": "./tests/helpers/globals-shim.ts",
    "@ursamu/mushcode": "jsr:@ursamu/mushcode@^0.7.0",
    "@ursamu/mushcode/eval": "jsr:@ursamu/mushcode@^0.7.0/eval",
    "@ursamu/mushcode/parse": "jsr:@ursamu/mushcode@^0.7.0/parse",
    "@ursamu/parser": "npm:@ursamu/parser@1.2.4",
    "@digibear/tags": "npm:@digibear/tags@1.0.0",
    "bcrypt": "npm:bcryptjs@2.4.3",
    "djwt": "jsr:@zaubrik/djwt@^3.0.2",
    "dotenv": "jsr:@std/dotenv@^0.224.0",
    "dotenv/": "jsr:@std/dotenv@^0.224.0/",
    "dotenv/load": "jsr:@std/dotenv@^0.224.0/load",
    "@std/dotenv": "jsr:@std/dotenv@^0.224.0",
    "@std/dotenv/": "jsr:@std/dotenv@^0.224.0/",
    "quickjs-emscripten": "npm:quickjs-emscripten@0.29.0",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/testing/bdd": "jsr:@std/testing@^0.224.0/bdd",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@std/flags": "jsr:@std/flags@^0.224.0",
    "@std/semver": "jsr:@std/semver@^1.0.0",
    "@std/fmt": "jsr:@std/fmt@^0.224.0",
    "@std/fmt/": "jsr:@std/fmt@^0.224.0/"
  }
}
