{
  "name": "@ursamu/jobs",
  "version": "0.1.1",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test tests/ --allow-all --unstable-kv --no-check",
    "lint": "deno lint",
    "check": "deno check mod.ts --unstable-kv",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "@ursamu/mush": "jsr:@ursamu/mush@^0.1.3",
    "@ursamu/core": "jsr:@ursamu/core@^0.1.0",
    "@ursamu/help": "jsr:@ursamu/help@^0.1.2",
    "@ursamu/help-plugin": "jsr:@ursamu/help@^0.1.2",
    "@ursamu/mail": "jsr:@ursamu/mail@^2.4.0",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.17/bdd"
  },
  "publish": {
    "include": [
      "src",
      "help",
      "mod.ts",
      "index.ts",
      "deno.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
