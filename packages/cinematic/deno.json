{
  "name": "@ursamu/cinematic-plugin",
  "version": "1.0.0",
  "description": "Cinematic Unisystem plugin for UrsaMU.",
  "license": "MIT",
  "exports": "./index.ts",
  "tasks": {
    "test": "deno test -A --unstable-kv --no-check --import-map=import_map.local.json",
    "check": "deno check --unstable-kv --import-map=import_map.local.json index.ts commands.ts",
    "showcase": "deno run -A --unstable-kv --import-map=showcase.importmap.json tools/showcase.ts",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types --no-check",
    "publish": "deno publish --allow-slow-types --no-check"
  },
  "imports": {
    "ursamu": "jsr:@ursamu/mush@^1.0.40",
    "@ursamu/mush": "jsr:@ursamu/mush@^1.0.40",
    "@ursamu/help/register": "jsr:@ursamu/help@^1.3.1/register",
    "@std/assert": "jsr:@std/assert@^0.224.0"
  },
  "publish": {
    "include": [
      "commands",
      "src",
      "data",
      "help",
      "index.ts",
      "commands.ts",
      "deno.json",
      "ursamu.plugin.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests",
      "tools",
      "showcases"
    ]
  }
}
