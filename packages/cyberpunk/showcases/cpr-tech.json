  "steps": [
    {
      "sub": "Maker Points (Tech Currency)"
    },
    {
      "note": "Maker Points represent materials and workshop access. Role rank determines total. Specialties (fabrication, upgrade, field, invention) are set by admin via +cpr/setmaker."
    },
    {
      "cmd": "+craft/makerpoints",
      "label": "view current Maker Point balance and specialty distribution"
    },
    {
      "sub": "Crafting Projects"
    },
    {
      "note": "Tech characters fabricate weapons, gadgets, cyberware, and armor. Format: +craft/start <item>=<priceCategory>. Valid categories: cheap, everyday, costly, premium, expensive, very_expensive."
    },
    {
      "cmd": "+craft/list",
      "label": "view all in-progress crafting projects"
    },
    {
      "cmd": "+craft/start Militech Avenger=costly",
      "label": "start fabricating a costly weapon (Militech Avenger)"
    },
    {
      "sub": "Blueprints"
    },
    {
      "note": "Blueprints are reusable plans that reduce future fabrication DV and time. Format: +craft/blueprint <item>=<category>."
    },
    {
      "cmd": "+craft/blueprint custom-grip=cheap",
      "label": "log a blueprint for a cheap custom-grip modification"
    },
    {
      "sub": "Field Repair"
    },
    {
      "note": "Field repair is available to all roles (not just Tech). It restores SP to damaged armor using TECH+basic_tech. Format: +craft/fieldrepair <item> <DV>."
    },
    {
      "cmd": "+craft/fieldrepair body armor 13",
      "label": "field-repair body armor (TECH+basic_tech vs DV 13)"
    },
    {
      "sub": "Pharmaceutical Synthesis (Medtech only)"
    },
    {
      "note": "+pharma commands require the Medtech role. A Medtech character uses +pharma/synth <drug> to start synthesis, +pharma/queue to view in-progress jobs, and +pharma/check <id> to collect. See +drug/list for available drugs."
    },
    {
      "sub": "Chop Shop — Cyberware Surgery (Medtech only)"
    },
    {
      "note": "+chopshop commands require the Medtech role. Prices and queue are viewable by anyone. Install and harvest require Medtech. Format: +chopshop/install <target>=<cyberware>, +chopshop/harvest <target>=<cyberware>."
    },
    {
      "cmd": "+chopshop/prices",
      "label": "view service cost list for install and harvest"
    },
    {
      "cmd": "+chopshop/queue",
      "label": "view the surgery queue for this chop shop"
    },
    {
      "reset": true
    }
  ]
}
