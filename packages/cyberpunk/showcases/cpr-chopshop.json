  "steps": [
    {
      "sub": "Open the Shop"
    },
    {
      "note": "Doc Samir opens a chopshop in the current room. His surgery skill and role rank determine what tier of cyberware he can install."
    },
    {
      "cmd": "+chopshop/open Doc Samir's Clinic",
      "label": "Doc Samir opens the chopshop"
    },
    {
      "sub": "Browse Available Services"
    },
    {
      "note": "+chopshop/list shows the active shop in this room — medtech name, tier cap, and queue status."
    },
    {
      "cmd": "+chopshop/list",
      "label": "list the active chopshop"
    },
    {
      "sub": "Check Prices"
    },
    {
      "note": "+chopshop/prices shows V what cyberware is available for installation and the cost breakdown by tier."
    },
    {
      "cmd": "+chopshop/prices",
      "label": "V checks the price list"
    },
    {
      "sub": "Buy and Install Chrome"
    },
    {
      "note": "+chopshop/buy queues an installation. For mall-tier chrome like a Neural Link, Doc Samir completes it on the spot."
    },
    {
      "cmd": "+chopshop/buy neural_link",
      "label": "V buys a Neural Link installation"
    },
    {
      "sub": "Inspect the Result"
    },
    {
      "note": "After installation, V's cyberware is visible on look. The Neural Link shows in her chrome list."
    },
    {
      "cmd": "look V",
      "label": "look at V — Neural Link now installed"
    },
    {
      "sub": "Harvest Chrome"
    },
    {
      "note": "+chopshop/harvest extracts cyberware from a willing patient. The chrome goes into extracted inventory and may be damaged depending on the surgery roll."
    },
    {
      "cmd": "+chopshop/harvest Jackie=Neural Link",
      "label": "Doc Samir harvests Jackie's Neural Link"
    },
    {
      "sub": "Close the Shop"
    },
    {
      "note": "+chopshop/close deactivates the shop. Any pending queue entries are cancelled."
    },
    {
      "cmd": "+chopshop/close",
      "label": "Doc Samir closes the chopshop"
    }
  ]
}
