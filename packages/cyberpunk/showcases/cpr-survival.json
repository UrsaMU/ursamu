    {
      "sub": "Resting & Recovery"
    },
    {
      "note": "Short rest: 8 hours, heals 2d6 HP. Long rest: 24 hours, full HP recovery. You must not be in combat."
    },
    {
      "cmd": "+rest",
      "label": "view current rest status and time remaining"
    },
    {
      "cmd": "+rest/start short",
      "label": "begin an 8-hour short rest (heals 2d6 HP)"
    },
    {
      "cmd": "+rest/status",
      "label": "check how much time remains on your rest"
    },
    {
      "cmd": "+rest/cancel",
      "label": "cancel an in-progress rest (forfeits healing)"
    },
    {
      "cmd": "+rest/start long",
      "label": "begin a 24-hour long rest (full HP recovery)"
    },
    {
      "cmd": "+rest/cancel",
      "label": "cancel long rest before continuing"
    },
    {
      "sub": "Nomad Pack Support"
    },
    {
      "note": "Nomads can call on their pack for support. Four request types, each on a 24-hour per-type cooldown. Rank scales the benefit."
    },
    {
      "cmd": "+pack/status",
      "label": "view pack support cooldowns and available request types"
    },
    {
      "cmd": "+pack/request supplies",
      "label": "request supplies from the pack — EB value scales with rank"
    },
    {
      "cmd": "+pack/request backup",
      "label": "request backup — NPCs arrive to assist in combat"
    },
    {
      "cmd": "+pack/request medical",
      "label": "request medical aid — heals 2d6 HP"
    },
    {
      "note": "+pack/request haven requires Rank 7+. It provides a hidden location for a long rest."
    },
    {
      "sub": "Scavenging"
    },
    {
      "note": "Scavenging yields random loot based on zone danger. 30-minute real-time cooldown between runs. Higher danger = better loot, higher ambush risk. Zone types: safe, contested, hot, combat, hellhole."
    },
    {
      "cmd": "+scavenge contested",
      "label": "scavenge a contested zone — moderate risk, better loot"
    },
    {
      "reset": true
    }
  ]
