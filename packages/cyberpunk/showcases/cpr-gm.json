  "steps": [
    {
      "sub": "Character Info & Debug"
    },
    {
      "note": "+cpr/info dumps the full character record as JSON. Useful for debugging or verifying DB state."
    },
    {
      "cmd": "+cpr/info V",
      "label": "dump full character record for player V",
      "as": "admin"
    },
    {
      "sub": "Stat & Skill Overrides"
    },
    {
      "note": "Stat and skill overrides use <target>/<field>=<value> format. Role and rank use <target>=<value>."
    },
    {
      "cmd": "+cpr/stat V/ref=8",
      "label": "set V's REF to 8",
      "as": "admin"
    },
    {
      "cmd": "+cpr/skill V/athletics=6",
      "label": "set V's Athletics to 6",
      "as": "admin"
    },
    {
      "cmd": "+cpr/role V=solo",
      "label": "change V's role to Solo",
      "as": "admin"
    },
    {
      "cmd": "+cpr/rank V=7",
      "label": "set V's role rank to 7",
      "as": "admin"
    },
    {
      "sub": "Economy & Reputation Overrides"
    },
    {
      "cmd": "+cpr/eb V=5000",
      "label": "set V's EB balance to 5000",
      "as": "admin"
    },
    {
      "cmd": "+cpr/rep V=5",
      "label": "set V's reputation to 5",
      "as": "admin"
    },
    {
      "sub": "Improvement Points"
    },
    {
      "note": "+ip awards Improvement Points to a player. Players spend IP via +improve to advance skills and role rank."
    },
    {
      "cmd": "+ip V=10",
      "label": "award 10 IP to V",
      "as": "admin"
    },
    {
      "sub": "Humanity & Healing"
    },
    {
      "cmd": "+cpr/hl V=20",
      "label": "set V's humanity loss to 20 (recalculates EMP)",
      "as": "admin"
    },
    {
      "cmd": "+cpr/heal V",
      "label": "fully heal V to max HP and clear wound state",
      "as": "admin"
    },
    {
      "sub": "Environmental Hazards"
    },
    {
      "note": "+hazard applies environmental damage to a target. Use for fires, drowning, falls, and electrocution."
    },
    {
      "cmd": "+hazard/fire V",
      "label": "apply fire damage to V (1d6 per round until extinguished)",
      "as": "admin"
    },
    {
      "cmd": "+hazard/extinguish V",
      "label": "extinguish a burning character",
      "as": "admin"
    },
    {
      "cmd": "+hazard/fall V 10",
      "label": "apply fall damage from 10 meters — 10d6 damage",
      "as": "admin"
    },
    {
      "cmd": "+hazard/electrocute V",
      "label": "apply electrocution damage to V",
      "as": "admin"
    },
    {
      "cmd": "+hazard/drown V",
      "label": "apply drowning damage to V",
      "as": "admin"
    },
    {
      "sub": "Maker Specialty"
    },
    {
      "note": "+cpr/setmaker grants a Tech character a maker specialty rank needed to run advanced crafting projects."
    },
    {
      "cmd": "+cpr/setmaker T-Bug/fabrication=4",
      "label": "set T-Bug's fabrication specialty to rank 4",
      "as": "admin"
    },
    {
      "sub": "Character Reset"
    },
    {
      "note": "+cpr/reset wipes the character record entirely. This is destructive — confirm before use."
    },
    {
      "cmd": "+cpr/reset V",
      "label": "wipe V's character data (admin only — destructive)",
      "as": "admin"
    },
    {
      "reset": true
    }
  ]
}
