  "steps": [
    {
      "sub": "Eurodollars"
    },
    {
      "note": "+eb with no switch shows your current balance. +eb/pay wires eddies to a nearby character."
    },
    {
      "cmd": "+eb",
      "label": "check EB balance"
    },
    {
      "cmd": "+eb/pay Rogue=500",
      "label": "wire 500 EB to Rogue (format: target=amount)"
    },
    {
      "sub": "Lifestyle"
    },
    {
      "note": "Lifestyle determines monthly upkeep costs. Failing to pay drops you a tier. Valid tiers: kibble, generic_prepak, streetrat, good_prepak, fresh_food, moderate, corporate, luxury."
    },
    {
      "cmd": "+lifestyle",
      "label": "view current lifestyle tier and next due date"
    },
    {
      "cmd": "+lifestyle/set moderate",
      "label": "upgrade lifestyle tier to moderate"
    },
    {
      "sub": "Drugs"
    },
    {
      "note": "Drugs provide temporary stat boosts or healing. Check +drug/list for all valid drug names."
    },
    {
      "cmd": "+drug/list",
      "label": "browse all available drugs and their effects"
    },
    {
      "cmd": "+drug/active",
      "label": "show currently active drug effects and time remaining"
    },
    {
      "cmd": "+drug/use speedheal",
      "label": "take Speedheal — heals BODY+WILL HP instantly (once per day)"
    },
    {
      "cmd": "+drug/use synthcoke",
      "label": "take Synthcoke — +1 REF for 4 hours"
    },
    {
      "cmd": "+drug/use stim",
      "label": "take Stim — ignore Seriously Wounded penalties for 1 hour"
    },
    {
      "cmd": "+drug/purge",
      "label": "force-clear all active drug effects (admin)"
    },
    {
      "sub": "Jobs Board"
    },
    {
      "note": "Fixers post jobs. Runners take them. Payout and rep scale with danger level. Jobs persist in the KV database between sessions."
    },
    {
      "cmd": "+job/list",
      "label": "view all open jobs on the board"
    },
    {
      "sub": "Night Market"
    },
    {
      "note": "Fixers (rank 5+) open Night Markets with +market/open. Anyone in the room can +market/browse. Sellers use +market/sell <item>=<price>=<category>. Buyers use +market/buy <id> or +market/haggle <id>=<offer>."
    },
    {
      "reset": true
    }
  ]
