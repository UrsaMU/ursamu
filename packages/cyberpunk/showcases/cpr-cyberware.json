    {
      "sub": "Cyberware"
    },
    {
      "note": "Cyberware is installed by Medtechs via +chopshop. Each piece has a Humanity Loss (HL) cost and install tier (mall/clinic/hospital)."
    },
    {
      "cmd": "+cyber/list",
      "label": "view all available cyberware by category"
    },
    {
      "cmd": "+cyber",
      "label": "view your currently installed cyberware and total HL"
    },
    {
      "cmd": "+cyber/list neuralware",
      "label": "browse neuralware items in the catalog"
    },
    {
      "note": "Categories: fashionware, neuralware, cyberoptics, cyberaudio, internal, external, cyberlimb, chipware."
    },
    {
      "note": "+cyber/install <name> and +cyber/remove <name> require the Medtech role or admin. Medtechs use +chopshop/install and +chopshop/harvest for surgery on others."
    },
    {
      "sub": "Armor"
    },
    {
      "note": "Armor has two slots: body and head. SP (Stopping Power) ablates on hit. Repair with TECH+basic_tech vs DV13."
    },
    {
      "cmd": "+armor",
      "label": "view equipped armor and current SP"
    },
    {
      "cmd": "+armor/list",
      "label": "browse the full armor catalog"
    },
    {
      "cmd": "+armor/remove body",
      "label": "unequip body armor"
    },
    {
      "cmd": "+armor/repair head",
      "label": "repair worn head armor — TECH+basic_tech vs DV13"
    },
    {
      "sub": "Bodysculpting"
    },
    {
      "note": "Bodysculpt mods are cosmetic or exotic body modifications. Applied by Medtechs or Admins. HL applies on install."
    },
    {
      "cmd": "+bodysculpt/list",
      "label": "browse modification catalog (cosmetic to exotic)"
    },
    {
      "cmd": "+bodysculpt",
      "label": "view your current bodysculpt modifications"
    },
    {
      "note": "+bodysculpt/get <mod> applies the modification to yourself. Requires Medtech role or Admin. +bodysculpt/remove <mod> removes it (Admin only)."
    },
