  "steps": [
    {
      "sub": "Character Sheet"
    },
    {
      "note": "+sheet with no switch shows the full sheet: stats, skills, combat derived values, economy, and cyberware."
    },
    {
      "cmd": "+sheet",
      "label": "full character sheet"
    },
    {
      "cmd": "+sheet/stats",
      "label": "stats section only"
    },
    {
      "cmd": "+sheet/skills",
      "label": "skills section only"
    },
    {
      "cmd": "+sheet/combat",
      "label": "combat stats \u2014 HP, wound state, armor, death save threshold"
    },
    {
      "cmd": "+sheet/cyber",
      "label": "installed cyberware and humanity loss"
    },
    {
      "cmd": "+sheet/economy",
      "label": "eurodollars and lifestyle"
    },
    {
      "sub": "Score (Compact View)"
    },
    {
      "note": "+score is a quick one-line summary of your core stats and current HP."
    },
    {
      "cmd": "+score",
      "label": "compact stat line"
    },
    {
      "sub": "Dice Rolls"
    },
    {
      "note": "+roll accepts a dice expression or a STAT+skill format. All rolls are d10 based."
    },
    {
      "cmd": "+roll 1d10",
      "label": "basic d10 roll"
    },
    {
      "cmd": "+roll 3d6",
      "label": "3d6 roll (used for some damage)"
    },
    {
      "cmd": "+roll ref+athletics",
      "label": "stat+skill check \u2014 REF + Athletics"
    },
    {
      "cmd": "+roll cool+stealth vs 15",
      "label": "stat+skill check against a DV"
    },
    {
      "cmd": "+roll int+perception vs 13",
      "label": "notice check \u2014 INT + Perception"
    },
    {
      "cmd": "+roll body+athletics vs 17",
      "label": "feat of strength check"
    },
    {
      "sub": "Luck"
    },
    {
      "note": "Luck points add +1 per point to any roll. Pool resets at start of each session. Max Luck = LUCK stat."
    },
    {
      "cmd": "+luck",
      "label": "view current luck pool"
    },
    {
      "cmd": "+luck 3",
      "label": "spend 3 luck on your next roll"
    },
    {
      "sub": "Improvement Points"
    },
    {
      "note": "IP (Improvement Points) are awarded by GMs for session milestones. Spend them to advance skills or role rank. Cost scales with target rank."
    },
    {
      "cmd": "+improve",
      "label": "view IP balance, lifetime total, and affordable advances"
    },
    {
      "cmd": "+improve/skill stealth",
      "label": "spend IP to raise Stealth by 1 rank (rank 4\u21925, costs 8 IP)"
    },
    {
      "sub": "Gear / Inventory"
    },
    {
      "note": "+gear shows your full loadout \u2014 armor, wielded weapons, carried items. Admin users see dbrefs. Concealed items marked [C]."
    },
    {
      "cmd": "+gear",
      "label": "full gear list"
    },
    {
      "cmd": "+gear/add Trauma Team card=gear",
      "label": "add a carried item"
    },
    {
      "cmd": "+gear/conceal g3",
      "label": "toggle concealed on Speed (partial id match)"
    },
    {
      "cmd": "+gear/equip g1=carried",
      "label": "holster the Lexington"
    },
    {
      "cmd": "+gear/remove g4",
      "label": "drop the medtech bag"
    },
    {
      "cmd": "+gear",
      "label": "gear list after changes"
    },
    {
      "reset": true
    }
  ]
