{
  "name": "@ursamu/builder",
  "version": "1.3.6",
  "exports": "./mod.ts",
  "tasks": {
    "test":  "deno test tests/ --allow-all --unstable-kv --no-check",
    "lint":  "deno lint",
    "check": "deno check mod.ts --unstable-kv"
  },
  "compilerOptions": { "lib": ["deno.window", "deno.unstable"] },
  "imports": {
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@ursamu/mush": "jsr:@ursamu/mush@^1.0.0",
    "@ursamu/mush/permissions": "jsr:@ursamu/mush@^1.0.0/permissions",
    "@ursamu/help": "jsr:@ursamu/help@^0.1.9",
    "@ursamu/help-plugin": "jsr:@ursamu/help@^0.1.9"
  },
  "publish": {
    "include": [
      "src",
      "help",
      "mod.ts",
      "deno.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE"
    ],
    "exclude": ["tests"]
  },
  "lint": { "rules": { "tags": ["recommended"] } }
}
