{
  "name": "@ursamu/core",
  "version": "1.0.5",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test tests/ --allow-all --unstable-kv --no-check",
    "lint": "deno lint",
    "check": "deno check mod.ts --unstable-kv",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types --no-check"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@std/semver": "jsr:@std/semver@^1.0.0",
    "djwt": "jsr:@zaubrik/djwt@^3.0.2",
    "zod": "npm:zod@4.4.3",
    "@nicia-ai/typegraph": "npm:@nicia-ai/typegraph@^0.31.0",
    "@nicia-ai/typegraph/postgres/pglite": "npm:@nicia-ai/typegraph@^0.31.0/postgres/pglite",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.5.2"
  },
  "publish": {
    "include": [
      "src",
      "docs",
      "mod.ts",
      "deno.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE"
    ],
    "exclude": [
      "tests"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
