{
  "key": "dnd-chargen",
  "label": "+cg -- Guided Character Generation",
  "description": "Walks through the guided character generator (+cg) to define class, origin, ability scores, skill proficiencies, starting gear, and finalize the sheet.",
  "vars": { "player": "Almaric" },
  "steps": [
    { "sub": "Stage 1: Choose a Class" },
    { "note": "Type +cg to initialize your character builder state." },
    { "cmd": "+cg", "label": "Start chargen wizard" },
    { "expect": "STAGE 1" },
    { "cmd": "+cg/list classes", "label": "List available classes" },
    { "expect": "Wizard" },
    { "cmd": "+cg/set class=Wizard", "label": "Set class to Wizard" },
    { "expect": "Wizard" },
    { "cmd": "+cg/next", "label": "Advance to Stage 2" },
    { "expect": "STAGE 2" },

    { "sub": "Stage 2: Choose Origin" },
    { "note": "Configure species and background." },
    { "cmd": "+cg/set species=Elf", "label": "Set species to Elf" },
    { "expect": "Elf" },
    { "cmd": "+cg/set background=Sage", "label": "Set background to Sage" },
    { "expect": "Sage" },
    { "cmd": "+cg/next", "label": "Advance to Stage 3" },
    { "expect": "STAGE 3" },

    { "sub": "Stage 3: Determine Ability Scores" },
    { "note": "Assign Point Buy ability scores costing exactly 27 points." },
    { "cmd": "+cg/set intelligence=15", "label": "Set base Intelligence to 15" },
    { "expect": "intelligence" },
    { "cmd": "+cg/set dexterity=14", "label": "Set base Dexterity to 14" },
    { "expect": "dexterity" },
    { "cmd": "+cg/set constitution=13", "label": "Set base Constitution to 13" },
    { "expect": "constitution" },
    { "cmd": "+cg/set wisdom=12", "label": "Set base Wisdom to 12" },
    { "expect": "wisdom" },
    { "cmd": "+cg/set strength=10", "label": "Set base Strength to 10" },
    { "expect": "strength" },
    { "cmd": "+cg/set charisma=8", "label": "Set base Charisma to 8" },
    { "expect": "charisma" },
    { "cmd": "+cg/next", "label": "Advance to Stage 4" },
    { "expect": "STAGE 4" },

    { "sub": "Stage 4: Choose Skill Proficiencies" },
    { "note": "Select skill proficiencies allowed by your class." },
    { "cmd": "+cg/set skill=insight", "label": "Select Insight proficiency" },
    { "expect": "insight" },
    { "cmd": "+cg/set skill=investigation", "label": "Select Investigation proficiency" },
    { "expect": "investigation" },
    { "cmd": "+cg/next", "label": "Advance to Stage 5" },
    { "expect": "STAGE 5" },
    { "sub": "Stage 5: Choose Feats" },
    { "note": "Choose 1 origin feat (or 2 if Human)." },
    { "cmd": "+cg/set feat=lucky", "label": "Customize feat selection to Lucky" },
    { "expect": "lucky" },
    { "cmd": "+cg/next", "label": "Advance to Stage 6" },
    { "expect": "STAGE 6" },

    { "sub": "Stage 6: Choose Spells" },
    { "note": "Select 3 class cantrips and 4 1st-level spells." },
    { "cmd": "+cg/set spell=fire_bolt", "label": "Choose Fire Bolt cantrip" },
    { "expect": "fire_bolt" },
    { "cmd": "+cg/set spell=light", "label": "Choose Light cantrip" },
    { "expect": "light" },
    { "cmd": "+cg/set spell=mage_hand", "label": "Choose Mage Hand cantrip" },
    { "expect": "mage_hand" },
    { "cmd": "+cg/set spell=magic_missile", "label": "Choose Magic Missile spell" },
    { "expect": "magic_missile" },
    { "cmd": "+cg/set spell=shield", "label": "Choose Shield spell" },
    { "expect": "shield" },
    { "cmd": "+cg/set spell=sleep", "label": "Choose Sleep spell" },
    { "expect": "sleep" },
    { "cmd": "+cg/set spell=thunderwave", "label": "Choose Thunderwave spell" },
    { "expect": "thunderwave" },
    { "cmd": "+cg/next", "label": "Advance to Stage 7" },
    { "expect": "STAGE 7" },

    { "sub": "Stage 7: Choose Starting Gear" },
    { "note": "Select standard class equipment or starting gold." },
    { "cmd": "+cg/set gear=equipment", "label": "Choose starting equipment" },
    { "expect": "Starting gear option set to equipment" },
    { "cmd": "+cg/set gear1=2", "label": "Choose dagger option" },
    { "expect": "Set choice 1 to option 2: Dagger" },
    { "cmd": "+cg/next", "label": "Advance to Stage 8" },
    { "expect": "STAGE 8" },

    { "sub": "Stage 8: Review and Submit" },
    { "note": "Finalize and compile the sheet." },
    { "cmd": "+cg/submit", "label": "Finalize character creation" },
    { "expect": "complete" },

    { "sub": "Viewing Character Sheet" },
    { "note": "Render the completed sheet." },
    { "cmd": "+sheet", "label": "View character sheet" },
    { "expect": "CHARACTER SHEET" },

    { "sub": "Weapons and Equipment" },
    { "note": "Spawn D&D weapons and armor." },
    { "cmd": "+item/create Longsword=weapon:1d8:slashing", "label": "Spawn Longsword" },
    { "expect": "Created item" },
    { "cmd": "+item/create Leather Armor=armor:11:light", "label": "Spawn Leather Armor" },
    { "expect": "Created item" },

    { "note": "Wield the weapon and wear the armor." },
    { "cmd": "+wield longsword", "label": "Wield longsword" },
    { "expect": "wield" },
    { "cmd": "+wear leather armor", "label": "Wear leather armor" },
    { "expect": "wear" },

    { "note": "View active inventory." },
    { "cmd": "+inv", "label": "Check inventory" },
    { "expect": "W E A P O N S" },

    { "note": "Roll weapon attack and damage." },
    { "cmd": "+roll attack", "label": "Roll attack" },
    { "expect": "attacks with" },
    { "cmd": "+roll damage", "label": "Roll damage" },
    { "expect": "damage" },

    { "note": "Try to drop an equipped item (expect failure)." },
    { "cmd": "drop longsword", "label": "Try to drop longsword" },
    { "expect": "cannot drop equipped" }
  ]
}
