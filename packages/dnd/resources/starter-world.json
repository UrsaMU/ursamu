{
  "id": "havenbrook-v1",
  "name": "Havenbrook",
  "playerStartKey": "square",
  "linkOoc": true,
  "rooms": [
    {
      "key": "square",
      "name": "Havenbrook Town Square",
      "description": "Cobblestones fan out from a weathered fountain of a knight raising a lantern. Market stalls cluster to the east; the inn's painted dragon sign creaks south. North, the gate road climbs toward dark trees. West, temple bells mark the hour. A chalk board near the fountain reads: newcomers — type +help dnd."
    },
    {
      "key": "inn",
      "name": "The Sleeping Dragon Inn",
      "description": "Warm light, stewed mutton, and the low murmur of travelers. A scarred oak bar runs the length of the room. Stairs lead up to private rooms. The innkeep nods at adventurers — rest is safe here (+rest/long when the story allows)."
    },
    {
      "key": "inn-rooms",
      "name": "Inn Upper Hall",
      "description": "A narrow hall of numbered doors and thin carpet. Perfect for quiet scenes. A window looks down on the square fountain."
    },
    {
      "key": "market",
      "name": "Market Row",
      "description": "Awnings stripe the lane in faded canvas. Spices, rope, and rumor trade hands. Peddlers call wares — type +list to browse. East, hammer-song rings from the open forge (weapons and armor)."
    },
    {
      "key": "forge",
      "name": "Blacksmith's Forge",
      "description": "Heat rolls from the open hearth. Sparks leap as steel meets anvil. Racks of blades, armor, and shields wait for coin. Type +list to browse, +buy <item> to purchase."
    },
    {
      "key": "temple",
      "name": "Temple of the Dawn",
      "description": "White stone and colored glass catch the light. An altar holds fresh lilies and a bowl of clear water. Soft chants suggest healing and second chances."
    },
    {
      "key": "gate",
      "name": "North Gate Road",
      "description": "Timber gates stand open by day. A dusty road climbs into the Whisperwood. A notice board warns of goblin raids north of the treeline."
    },
    {
      "key": "barracks",
      "name": "Guard Barracks",
      "description": "Bunks, weapon racks, and a map of local trails. Off-duty guards dice for copper. Staff can stage escorts from here."
    },
    {
      "key": "path",
      "name": "Whisperwood Path",
      "description": "Old oaks lean over a rutted trail. Birdsong thins the farther you walk. Tracks in the mud suggest more than deer."
    },
    {
      "key": "ruins",
      "name": "Mossy Waystone Ruins",
      "description": "Broken pillars and a half-buried waystone. Glyphs glow faintly at dusk. A good place for skill checks and secrets."
    },
    {
      "key": "camp",
      "name": "Goblin Camp",
      "description": "Crude lean-tos, a smoky firepit, and a cage of stolen chickens. The air smells of grease and mischief. Combat is expected — +combat/start when ready."
    }
  ],
