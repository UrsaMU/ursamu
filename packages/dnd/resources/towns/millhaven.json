  "rooms": [
    {
      "key": "square",
      "name": "Millhaven Green",
      "description": "A muddy green around a leaning mill-post. Barges creak on the river east; the mill wheel thuds west. South, the forest road climbs toward Havenbrook. A notice board lists bounties (+bounty)."
    },
    {
      "key": "mill",
      "name": "Riverside Mill",
      "description": "Great stones grind grain under a wet wooden wheel. Sacks of flour lean against the wall. The miller sells trail bread and rope."
    },
    {
      "key": "dock",
      "name": "Millhaven Dock",
      "description": "Pilings dark with river water. Nets dry on racks. Fishers mutter about things that surface at night downstream."
    },
    {
      "key": "inn",
      "name": "The Otter's Rest",
      "description": "Low beams, river-reed mats, and a fire that never quite dies. Safe rest for travelers (+rest/long)."
    },
    {
      "key": "road",
      "name": "South Road Spur",
      "description": "Packed earth toward the Whisperwood and Havenbrook. Dust, cart ruts, and the occasional broken arrow."
    }
  ],
