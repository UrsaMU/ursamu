{
  "name": "@ursamu/mail",
  "version": "2.7.0",
  "description": "In-game mail for UrsaMU — drafts, folders, attachments, quota, expiry, and REST API.",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "test": "deno test tests/ --allow-all --unstable-kv --no-check",
    "lint": "deno lint",
    "check": "deno check mod.ts --unstable-kv",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types --no-check",
    "publish": "deno publish --allow-slow-types --no-check"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "@ursamu/mush": "jsr:@ursamu/mush@^1.0.0",
    "@ursamu/core": "jsr:@ursamu/core@^1.0.0",
    "@ursamu/help": "jsr:@ursamu/help@^1.0.0",
    "@ursamu/help-plugin": "jsr:@ursamu/help@^1.0.0",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.17/bdd"
  },
  "publish": {
    "include": [
      "src",
      "help",
      "docs",
      "mod.ts",
      "index.ts",
      "deno.json",
      "ursamu.plugin.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE"
    ],
    "exclude": [
      "tests"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
