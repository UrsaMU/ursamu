{
  "name": "@ursamu/lang-plugin",
  "version": "3.1.1",
  "description": "Per-listener language garbling for UrsaMU with configurable phoneme-based fake speech.",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test -A --unstable-kv --no-check",
    "lint": "deno lint",
    "check": "deno check index.ts mod.ts",
    "showcase": "deno run -A tools/showcase.ts",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types --no-check"
  },
  "lint": {
    "exclude": [
      "scripts/"
    ]
  },
  "fmt": {
    "exclude": [
      "scripts/"
    ]
  },
  "publish": {
    "include": [
      "src",
      "languages",
      "help",
      "mod.ts",
      "index.ts",
      "commands.ts",
      "deno.json",
      "README.md"
    ],
    "exclude": [
      "tests",
      "tools",
      "docs",
      "scripts",
      "config"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/testing/bdd": "jsr:@std/testing@^0.224.0/bdd",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@ursamu/mush": "jsr:@ursamu/mush@^0.1.3",
    "@ursamu/help-plugin": "../help/mod.ts",
    "@ursamu/help": "../help/mod.ts",
    "@ursamu/help/register": "../help/register.ts"
  }
}
