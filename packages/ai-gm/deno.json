{
  "name": "@ursamu/ai-gm",
  "version": "0.2.3",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "test": "deno test --allow-all --unstable-kv --no-check tests/",
    "check": "deno check mod.ts index.ts",
    "lint": "deno lint",
    "preflight": "deno publish --dry-run --allow-dirty --allow-slow-types"
  },
  "imports": {
    "@std/dotenv": "jsr:@std/dotenv@^0.224.0",
    "@ursamu/mush": "jsr:@ursamu/mush@^1.0.0",
    "@ursamu/jobs": "jsr:@ursamu/jobs@^1.0.0",
    "@ursamu/bbs": "jsr:@ursamu/bbs@^1.0.0",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.17/bdd",
    "@std/testing/mock": "jsr:@std/testing@^1.0.17/mock",
    "@langchain/anthropic": "npm:@langchain/anthropic@^0.3.0",
    "@langchain/google-genai": "npm:@langchain/google-genai@^0.2.0",
    "@langchain/langgraph": "npm:@langchain/langgraph@^0.2.0",
    "@langchain/langgraph/prebuilt": "npm:@langchain/langgraph@^0.2.0/prebuilt",
    "@langchain/core": "npm:@langchain/core@^0.3.0",
    "zod": "npm:zod@^3.23.0",
    "stripe": "npm:stripe@^17.0.0",
    "unpdf": "npm:unpdf@^0.11.0"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "publish": {
    "include": [
      "api",
      "commands.ts",
      "context",
      "db.ts",
      "docs",
      "game-hooks-augment.ts",
      "graphs",
      "hooks.ts",
      "index.ts",
      "ingestion",
      "mod.ts",
      "monetization",
      "prompts",
      "providers.ts",
      "rag.ts",
      "round-manager.ts",
      "schema.ts",
      "social",
      "systems",
      "tools.ts",
      "ursamu.plugin.json",
      "deno.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests",
      ".env",
      ".env.example"
    ]
  }
}
