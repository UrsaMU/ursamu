# ─── AI-GM Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Required: Google Gemini API key
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Stripe payment integration
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Discord webhook for mirroring GM output to a channel
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Required for REST API (/api/gm/*) unless GM_API_OPEN=1
GM_API_SECRET=change-me-to-a-long-random-string
# Set to 1 only for local dev without a secret (fail-open)
# GM_API_OPEN=1


# Optional: Base URL for Stripe payment redirect links
GAME_URL=https://yourgame.example.com

# Optional: Base URL for wiki lore tools
WIKI_BASE_URL=http://localhost:4201
