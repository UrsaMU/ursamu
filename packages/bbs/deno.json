{
  "name": "@ursamu/bbs",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test tests/ --allow-all --unstable-kv --no-check",
    "lint": "deno lint",
    "check": "deno check mod.ts --unstable-kv"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.17/bdd",
    "@ursamu/jobs": "../jobs/mod.ts",
    "@ursamu/mush": "../mush/mod.ts",
    "@ursamu/help-plugin": "../help/mod.ts"
  },
  "publish": {
    "include": [
      "src",
      "help",
      "mod.ts",
      "deno.json",
      "README.md"
    ],
    "exclude": [
      "tests"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
