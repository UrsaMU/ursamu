      "level": 0,
      "notes": ""
    },
    "items": [
      {
        "slug": "yeheyuan",
        "name": "Yeheyuan cigarettes",
        "kind": "consumable",
        "load": 1,
        "uses": 3,
        "usesMax": 3,
        "unit": "cigarette",
        "useEffect": "narrative"
      },
      {
        "slug": "lazarus-patches",
        "name": "Lazarus Patches",
        "kind": "consumable",
        "load": 1,
        "uses": 2,
        "unit": "patch",
        "useEffect": "lazarus"
      }
    ]
  },
  "steps": [
    { "sub": "Catalog browse" },
    { "cmd": "+gear/catalog firearms", "label": "guns" },
    { "expect": "pkd-45" },
    { "cmd": "+gear/catalog melee", "label": "blades" },
    { "cmd": "+gear/catalog armor", "label": "armor" },

    { "sub": "Buy Things" },
    { "cmd": "+gear/buy pkd-45", "label": "buy revolver" },
    { "expect": "Bought" },
    { "cmd": "+gear/buy monoknife", "label": "buy monoknife" },
    { "cmd": "inv", "label": "builtin inventory" },
    { "expect": "cigarette" },
    { "cmd": "+loadout", "label": "loadout score" },

    { "sub": "Weapon mods (attach / nest / detach)" },
    { "cmd": "+gear/catalog mods", "label": "mod catalog" },
    { "expect": "targeting-scope" },
    { "cmd": "+gear/buy targeting-scope", "label": "buy scope" },
    { "expect": "Bought" },
    { "cmd": "+gear/buy custom-grips", "label": "buy grips" },
    { "cmd": "+gear/buy silencer", "label": "buy silencer" },
    { "cmd": "inv", "label": "loose mods in inv" },
    { "expect": "mod" },
    { "cmd": "+gear/mod pkd-45=targeting-scope", "label": "attach scope" },
    { "expect": "Attached" },
    { "cmd": "+gear/mod pkd-45=custom-grips", "label": "attach grips" },
    { "cmd": "+gear/mod pkd-45=silencer", "label": "attach silencer" },
    { "cmd": "+gear/mod pkd-45", "label": "list mods on gun" },
    { "expect": "targeting-scope" },
    { "cmd": "inv", "label": "nested mods under host" },
    { "expect": "Targeting scope" },
    { "cmd": "+gear/unmod pkd-45=silencer", "label": "detach silencer" },
    { "expect": "Detached" },
    { "cmd": "inv", "label": "silencer loose again" },
    { "expect": "Silencer" },

    { "sub": "Worn armor / power frame" },
    { "cmd": "+gear/buy exo-frame", "label": "buy exo-frame" },
    { "expect": "Bought" },
    { "cmd": "+gear/buy coil-suit", "label": "buy coil suit" },
    { "cmd": "inv", "label": "armor carried (no fight bonus yet)" },
    { "expect": "Mor+1" },
    { "cmd": "wear", "label": "equip help bare" },
    { "expect": "wield" },
    { "cmd": "wear exo-frame", "label": "wear power frame" },
    { "expect": "Wearing" },
    { "cmd": "+loadout", "label": "loadout max doubled" },
    { "expect": "20" },
    { "cmd": "+roll morphology/10", "label": "Mor +1 from exo" },
    { "expect": "Exo" },
    { "cmd": "wear coil-suit", "label": "wear coil" },
    { "cmd": "+roll reaction/10", "label": "Rea +1 from coil" },
    { "expect": "Coil" },
    { "cmd": "+attack/melee 10", "label": "armor fight bonus while worn" },
    { "expect": "Exo" },
    { "cmd": "stow exo-frame", "label": "stow exo" },
    { "cmd": "+loadout", "label": "loadout max back" },
    { "expect": "10" },
    { "cmd": "wield pkd-45", "label": "wield gun plain verb" },
    { "expect": "Wielding" },

    { "sub": "Use charges (builtin use)" },
    { "cmd": "use yeheyuan", "label": "smoke one" },
    { "expect": "2" },
    { "cmd": "use yeheyuan", "label": "smoke two" },
    { "cmd": "use yeheyuan", "label": "last smoke" },
    { "expect": "Gone" },
    { "cmd": "+lazarus", "label": "burn a patch" },
    { "expect": "1 left" },
    { "cmd": "use lazarus", "label": "use last patch" },

    { "sub": "Augmentations" },
    { "cmd": "+aug/catalog", "label": "aug list" },
    { "cmd": "+aug/install neural-lattice", "label": "install aug" },
    { "cmd": "+aug", "label": "installed augs" },
    { "expect": "Neural" },

    { "sub": "Shardware" },
    { "cmd": "+shard/catalog", "label": "shard list" },
    { "cmd": "+shard/jack kung-fu", "label": "jack shard" },
    { "cmd": "+shard", "label": "active shards" },
    { "cmd": "+shard/eject kung-fu", "label": "eject shard" },

    { "sub": "Personal drones" },
    { "cmd": "+gear/catalog drones", "label": "drone catalog" },
    { "expect": "medi-drone" },
    { "cmd": "+gear/buy medi-drone", "label": "buy medi" },
    { "expect": "Bought" },
    { "cmd": "+gear/buy bomb-drone", "label": "buy bomb" },
    { "cmd": "+drone", "label": "drone list" },
    { "expect": "medi-drone" },
    { "cmd": "+drone/deploy medi-drone", "label": "deploy medi" },
    { "expect": "Deployed" },
    { "cmd": "+drone/use", "label": "medi heal +2" },
    { "expect": "Medi" },
    { "cmd": "+drone/stow", "label": "recall medi" },
    { "expect": "Stowed" },
    { "cmd": "+drone/deploy bomb-drone", "label": "deploy bomb" },
    { "cmd": "+drone/use", "label": "detonate bomb" },
    { "expect": "detonat" },

    { "sub": "Street market" },
    { "cmd": "+market", "label": "category index" },
    { "expect": "CATEGORIES" },
    { "cmd": "+market firearm", "label": "browse guns table" },
    { "expect": "120" },
    { "cmd": "+market/info 1", "label": "detail row 1" },
    { "expect": "Buy:" },
    { "cmd": "+market toolkit", "label": "lookup toolkit" },
    { "expect": "150" },
    { "cmd": "+market/buy toolkit", "label": "purchase toolkit" }
  ]
}
