{
  "name": "@ursamu/sprawl-plugin",
  "version": "1.0.0",
  "description": "Sprawl Goons: Upgraded system plugin for UrsaMU.",
  "exports": "./index.ts",
  "tasks": {
    "test": "deno test -A --unstable-kv --no-check",
    "check": "deno check --unstable-kv index.ts commands.ts",
    "showcase": "deno run -A --unstable-kv --import-map=showcase.importmap.json tools/showcase.ts"
  },
  "publish": {
    "include": [
      "commands",
      "chargen",
      "engine",
      "db",
      "data",
      "help",
      "docs",
      "integrations",
      "index.ts",
      "commands.ts",
      "routes.ts",
      "deno.json",
      "ursamu.plugin.json",
      "README.md",
      "FIRST-HOUR.md",
      "CHANGELOG.md",
      "LICENSE"
    ],
    "exclude": [
      "tests",
      "books",
      "tools"
    ]
  },
  "imports": {
    "ursamu": "../mush/mod.ts",
    "@ursamu/mush": "../mush/mod.ts",
    "@ursamu/help": "../help/mod.ts",
    "@ursamu/help/register": "../help/register.ts",
    "@ursamu/jobs": "../jobs/mod.ts",
    "@ursamu/mail": "../mail/mod.ts",
    "@std/assert": "jsr:@std/assert@^0.224.0"
  }
}
