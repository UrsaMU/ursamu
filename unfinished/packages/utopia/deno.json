{
  "name": "@ursamu/utopia",
  "version": "0.1.1",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test tests/ --allow-all --unstable-kv --no-check",
    "smoke": "deno run -A --unstable-kv e2e/smoke.ts",
    "lint": "deno lint",
    "check": "deno check mod.ts --unstable-kv"
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"]
  },
  "imports": {
    "@ursamu/mush": "jsr:@ursamu/mush@^1.0.0",
    "@ursamu/help/register": "../help/register.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "publish": {
    "include": [
      "src",
      "data",
      "help",
      "commands",
      "mod.ts",
      "index.ts",
      "deno.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "ursamu.plugin.json"
    ],
    "exclude": ["tests"]
  }
}
