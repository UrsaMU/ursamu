{
  "key": "npc-flow",
  "title": "+npc -- spawn, fight, and destroy NPC antagonists",
  "description": "Staff spawns a Thug from the JSON catalog, opens combat, Jax and Goon exchange blows (Jax first by initiative), then the ST ends the scene and cleans up.",
  "vars": { "player": "Jax" },
  "setup": {
    "character": {
      "state": {
        "cofd": {
          "template": "mortal",
          "attributes": {
            "intelligence": 2,
            "wits": 2,
            "resolve": 2,
            "strength": 3,
            "dexterity": 2,
            "stamina": 2,
            "presence": 2,
            "manipulation": 2,
            "composure": 2
          },
          "skills": { "brawl": 2, "athletics": 2 },
          "advantages": {
            "willpowerMax": 4,
            "willpowerCurrent": 4,
            "size": 5
          },
          "health": { "bashing": 0, "lethal": 0, "aggravated": 0 },
          "equipment": {
            "equippedWeapon": null,
            "equippedArmor": null
          }
        }
      }
    },
    "room": {
      "name": "Back Alley",
      "desc": "Wet brick and a single sodium light."
    }
  },
  "steps": [
    { "sub": "Browse NPC List in an Empty Room" },
    {
      "note": "Anyone can +npc list. Empty rooms show JSON template slugs in columns."
    },
    { "cmd": "+npc", "label": "Jax checks the alley" },
    { "expect": "Templates:" },
    { "expect": "thug" },

    { "sub": "Staff Spawns a Thug" },
    {
      "note": "Only staff may /create. The NPC is a real object flagged npc from resources/npcs/thug.json."
    },
    {
      "cmd": "+npc/create Goon=thug",
      "as": "admin",
      "label": "ST drops in a thug"
    },
    { "expect": "Created" },
    { "expect": "Thug" },

    { "sub": "List Shows the New NPC" },
    { "cmd": "+npc/list", "label": "Jax sees Goon in the room" },
    { "expect": "Goon" },

    { "sub": "Open Combat" },
    {
      "note": "+combat/start auto-joins room NPCs. Jax still joins as a PC."
    },
    {
      "cmd": "+combat/start",
      "as": "admin",
      "label": "ST opens the encounter"
    },
    { "expect": "encounter" },
    { "cmd": "+combat/join", "label": "Jax joins" },
    { "expect": "joined" },
    {
      "cmd": "+combat/begin",
      "as": "admin",
      "label": "Roll initiative"
    },
    { "expect": "Round 1" },
    { "expect": "Jax" },
    { "expect": "Goon" },

    { "sub": "Round 1 -- Jax Acts; NPC AI Auto-Walks" },
    {
      "note": "After +attack, endTurnAndWalk runs NPC turns automatically until the next PC. No +combat/next needed. (Use +combat/next only to pass or end a non-attack turn.)"
    },
    {
      "cmd": "+attack Goon",
      "label": "Jax punches Goon"
    },
    { "expect": "attack" },
    { "expect": "Goon" },
    {
      "note": "Goon's AI turn and the advance to Round 2 appear in the same attack output."
    },
    { "expect": "turn" },

    { "sub": "Close the Scene and Clean Up" },
    {
      "cmd": "+combat/end",
      "as": "admin",
      "label": "ST ends the fight"
    },
    { "expect": "ended" },
    {
      "cmd": "+npc/destroy Goon",
      "as": "admin",
      "label": "ST removes the NPC"
    },
    { "expect": "Destroyed" },

    { "reset": true }
  ]
}
